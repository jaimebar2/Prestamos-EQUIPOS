# Neon PostgreSQL connection string
# Formato: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://usuario:password@ep-xxx.us-east-1.aws.neon.tech/prestamos?sslmode=require

# Secreto para firmar tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia_esto_por_un_secreto_seguro_muy_largo

# URL del frontend en Vercel (para CORS)
FRONTEND_URL=https://tu-proyecto.vercel.app

# Puerto local (Railway lo asigna automáticamente)
PORT=3000
